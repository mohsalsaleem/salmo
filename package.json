{
  "name": "mohsal-framework",
  "version": "0.1.0",
  "description": "A small, browser-native UI framework with first-class module federation, TC39 Signals reactivity, and vendored lit-html templating. Zero build step.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsalsaleem/mohsal-framework.git"
  },
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./ssr": {
      "import": "./src/ssr.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:conformance": "vitest run -c vitest.conformance.config.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.types-test.json",
    "types": "tsc"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "lit-html": "^3.3.3"
  }
}
