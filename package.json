{
  "name": "mohsal-framework",
  "version": "0.0.1",
  "description": "A tiny signals-based frontend framework",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./ssr": {
      "import": "./src/ssr.js"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:conformance": "vitest run -c vitest.conformance.config.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.types-test.json",
    "types": "tsc"
  },
  "devDependencies": {
    "happy-dom": "^15.11.7",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
